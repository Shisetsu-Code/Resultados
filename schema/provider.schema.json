{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provider.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "provider_id",
    "display_name",
    "games",
    "common_endpoints"
  ],
  "properties": {
    "provider_id": {
      "type": "string"
    },
    "games": {
      "type": "array"
    },
    "common_endpoints": {
      "type": "array"
    }
  }
}